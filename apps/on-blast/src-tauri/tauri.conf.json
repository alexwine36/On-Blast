{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "on-blast",
	"version": "0.1.0",
	"identifier": "com.alexwine.on-blast",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run typecheck && bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "on-blast",
				"width": 1000,
				"height": 760,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"entitlements": "entitlements.plist"
		}
	}
}
